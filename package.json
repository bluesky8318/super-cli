{
  "name": "@bluesky8318/super-cli",
  "version": "0.2.1",
  "description": "AI coding assistant session manager for Claude Code, Qoder, and Codex",
  "type": "module",
  "bin": {
    "super-cli": "./dist/cli/index.js"
  },
  "files": [
    "dist/cli",
    "dist/server",
    "dist/web",
    "dist/chunk-*.js",
    "skills",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluesky8318/super-cli.git"
  },
  "homepage": "https://github.com/bluesky8318/super-cli#readme",
  "bugs": {
    "url": "https://github.com/bluesky8318/super-cli/issues"
  },
  "scripts": {
    "build": "pnpm build:cli && pnpm build:web",
    "build:cli": "tsup",
    "build:web": "vite build --config src/web/vite.config.ts",
    "dev": "tsup --watch",
    "dev:web": "vite dev --config src/web/vite.config.ts",
    "test": "vitest",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "session",
    "cli",
    "manager"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.3.3",
    "globby": "^14.1.0",
    "marked": "^18.0.4",
    "open": "^10.1.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
